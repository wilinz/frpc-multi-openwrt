#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/libexec/frpc-multi/frpc
# 每个实例一个目录, 里面每个 .toml 是一份 frpc 配置(各连一台 frps), 同一实例的配置共用一个进程
CONFDIR=/etc/frpc-multi
# procd 用 argv[0] 的文件名作 syslog 标签, 每个实例经各自的软链接启动,
# 日志就带上实例名(frpc-<实例>[pid]), LuCI 按它过滤
RUNDIR=/var/run/frpc-multi

start_instance() {
	local s="$1" enabled disabled f name files="" n=0 rundir
	config_get_bool enabled "$s" enabled 0
	[ "$enabled" = "1" ] || return 0
	# 停用的配置文件, 按文件名(不含 .toml)列出
	config_get disabled "$s" disabled

	for f in "$CONFDIR/$s"/*.toml; do
		[ -s "$f" ] || continue
		name="${f##*/}"
		case " $disabled " in *" ${name%.toml} "*) continue ;; esac
		files="$files $f"
		n=$((n + 1))
	done
	[ $n -gt 0 ] || {
		logger -p daemon.warn -t "frpc-$s" "no enabled non-empty .toml in $CONFDIR/$s, skipped"
		return 0
	}

	mkdir -p $RUNDIR
	ln -sf $PROG "$RUNDIR/frpc-$s"

	procd_open_instance "$s"
	if [ $n -eq 1 ]; then
		# 单个配置照常 -c: 出错退出后 procd 会拉起
		procd_set_param command "$RUNDIR/frpc-$s" -c $files
	else
		# 多个配置用 --config-dir 跑在同一进程; 它会加载目录下所有文件,
		# 所以另建一个只含 .toml 软链接的目录, 免得备份之类的文件被当成配置
		rundir="$RUNDIR/$s.d"
		rm -rf "$rundir" && mkdir -p "$rundir"
		for f in $files; do
			ln -s "$f" "$rundir/${f##*/}"
		done
		procd_set_param command "$RUNDIR/frpc-$s" --config-dir "$rundir"
	fi
	# 任一配置文件内容变了, reload 时 procd 会重启这个实例
	procd_set_param file $files
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load frpc-multi
	config_foreach start_instance instance
}

service_triggers() {
	procd_add_reload_trigger "frpc-multi"
}
