#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/libexec/frpc-multi/frpc
CONFDIR=/etc/frpc-multi
# procd 用 argv[0] 的文件名作 syslog 标签, 每个实例经各自的软链接启动,
# 日志就带上实例名(frpc-<实例>[pid]), LuCI 按它过滤
RUNDIR=/var/run/frpc-multi

start_instance() {
	local s="$1" enabled conf
	config_get_bool enabled "$s" enabled 0
	[ "$enabled" = "1" ] || return 0

	conf="$CONFDIR/$s.toml"
	[ -s "$conf" ] || {
		logger -p daemon.warn -t "frpc-$s" "$conf missing or empty, skipped"
		return 0
	}

	mkdir -p $RUNDIR
	ln -sf $PROG "$RUNDIR/frpc-$s"

	procd_open_instance "$s"
	procd_set_param command "$RUNDIR/frpc-$s" -c "$conf"
	# 配置文件内容变了, reload 时 procd 会重启这个实例
	procd_set_param file "$conf"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load frpc-multi
	config_foreach start_instance instance
}

service_triggers() {
	procd_add_reload_trigger "frpc-multi"
}
