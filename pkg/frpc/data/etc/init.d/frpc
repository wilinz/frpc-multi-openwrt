#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/frpc
CONFDIR=/etc/frpc

start_instance() {
	local s="$1" enabled conf
	config_get_bool enabled "$s" enabled 0
	[ "$enabled" = "1" ] || return 0

	conf="$CONFDIR/$s.toml"
	[ -s "$conf" ] || {
		logger -t frpc "instance $s: $conf missing or empty, skipped"
		return 0
	}

	procd_open_instance "$s"
	procd_set_param command $PROG -c "$conf"
	# 配置文件内容变了, reload 时 procd 会重启这个实例
	procd_set_param file "$conf"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load frpc
	config_foreach start_instance instance
}

service_triggers() {
	procd_add_reload_trigger "frpc"
}
