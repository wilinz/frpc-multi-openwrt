{
	"luci-app-frpc": {
		"description": "Grant access to frpc",
		"read": {
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/etc/frpc/*": [ "read" ]
			},
			"uci": [ "frpc" ]
		},
		"write": {
			"ubus": {
				"luci": [ "setInitAction" ]
			},
			"file": {
				"/etc/frpc/*": [ "write" ]
			},
			"uci": [ "frpc" ]
		}
	}
}
